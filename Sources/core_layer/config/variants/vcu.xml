<?xml version="1.0" encoding="UTF-8"?>
<!--
  River FW SDK - NXP S32K144/146 peripheral configuration (VCU).
  Single source of truth for per-product driver config. Consumed at BUILD TIME by
  core_layer/config/tools/gen_config.py, which emits core_layer/config/generated_code/<product>/inc/
  rr_hw_cfg.h. There is NO runtime XML parse on the MCU. Edit values here, re-run the
  generator, re-gate. Values mirror the VCU source repo (rx_03_ry_01_vcu_nxp/Generated_Code).
-->
<product name="vcu" mcu="S32K144" cpu="S32K144HFT0VLLT">

	<!-- Clock tree (shared VCU/BMS default). -->
	<clock src="SIRC" src_hz="8000000" firc_hz="48000000" pll="SPLL"
	       divcore="2" divbus="2" divslow="4"/>

	<!-- LPSPI: 3 instances, all 8-bit frames (PAL frameSize is 8/16/32 only). lpspi_2 runs slow (100 kHz). -->
	<spi present="1" src_clk_hz="8000000" timeout_ms="100">
		<instance id="0" hw="0" baud="4000000" frame_bits="8"/>
		<instance id="1" hw="1" baud="4000000" frame_bits="8"/>
		<instance id="2" hw="2" baud="100000"  frame_bits="8"/>
	</spi>

	<!-- LPI2C: absent on VCU (baud carried only so the bsp fallback resolves from config). -->
	<i2c present="0" timeout_ms="50" baud="100000"/>

	<!-- ADC: 2 conversion groups (8 + 6 channels), 12-bit, 10-deep averaging. -->
	<adc present="1" resolution="12BIT" clock_divide="1" voltage_ref="VREF"
	     avg_depth="10" max_channels="16">
		<group id="0" channels="8"/>
		<group id="1" channels="6"/>
	</adc>

	<!-- FTM timer: FTM1 (live timebase) + FTM3 (3rd HIL-test instance -> TIMER_INSTANCE_2 / TIMER3_INST).
	     FTM0 is already owned by the PWM PAL (PWM1_INST) and FTM2 is reserved for a future PWM2_INST,
	     so the 3rd rr_timer instance skips ahead to FTM3, the only free FTM on this board.
	     Per-instance vendor-neutral tokens (emitted to rr_hw_cfg.h; bsp maps to the SDK enum):
	       clk_src   : SYSTEM (default) | FIXED | EXTERNAL   -> timer_clk_src_te
	       prescaler : 1 (default) | 2 | 4 | 8 | 16 | 32 | 64 | 128 (divide) -> timer_prescaler_te
	       mode      : CONTINUOUS (default) | ONESHOT
	     channels <= channel_max. -->
	<timer present="1" channel_max="8">
		<instance hw="1" channels="5" mode="CONTINUOUS" clk_src="SYSTEM" prescaler="8"/>
		<instance hw="3" channels="1" mode="CONTINUOUS" clk_src="SYSTEM" prescaler="1"/>
	</timer>

	<!-- FlexCAN: both buses full bitrate (preDivider 9). -->
	<can present="1">
		<instance id="0" prop_seg="7" pseg1="4" pseg2="1" pre_divider="9" rjw="1"/>
		<instance id="1" prop_seg="7" pseg1="4" pseg2="1" pre_divider="9" rjw="1"/>
	</can>

	<!-- Watchdog: internal WDOG only, LPO clocked. Routed through the WDG PAL (WDG_OVER_WDOG); the
	     external EWM secondary watchdog is not used on this product. -->
	<watchdog present="1">
		<instance type="internal" timeout="1024" clk="LPO" window_percent="50"/>
	</watchdog>

	<!-- CRC: not used on VCU. -->
	<crc present="0"/>

	<!-- PWM PAL: period 5000. -->
	<pwm present="1" period="5000"/>

	<!-- RTC: external RTC chip on SPI. -->
	<rtc present="1" type="external" bus="SPI"/>

</product>
